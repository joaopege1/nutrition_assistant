# Copy to .env and edit as needed. .env is gitignored.
# These are consumed by docker-compose.yml for local development.

# --- Postgres (local dev only) ---
POSTGRES_USER=rcu_app
POSTGRES_PASSWORD=rcu_app_dev
POSTGRES_DB=rcu_app

# --- Backend ---
# Generate a real one for production: `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=dev-only-not-for-prod
